{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>tyutyutyu/github-manager//renovate/default",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Budapest",
  "prConcurrentLimit": 5,
  "enabledManagers": ["cargo", "github-actions", "npm", "nodenv", "dockerfile", "custom.regex"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Group non-major Cargo updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo non-major"
    },
    {
      "description": "Group GitHub Actions and cargo-deny updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group the pinned Node.js version with the locked npm tools in tools/",
      "matchManagers": ["npm", "nodenv"],
      "groupName": "node tools"
    },
    {
      "description": "Group CI-installed Cargo tools with GitHub Actions updates",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["crate"],
      "matchPackageNames": ["cargo-deny", "cargo-llvm-cov"],
      "groupName": "github actions"
    },
    {
      "description": "Pinned developer and CI Rust toolchain; the MSRV in Cargo.toml changes only by decision",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["rust-lang/rust"],
      "groupName": "rust toolchain"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Rust toolchain pinned in rust-toolchain.toml",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Cargo tools pinned in CI workflows, the gate script and their documentation",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/^scripts/.+\\.sh$/", "/^README\\.md$/", "/^AGENTS\\.md$/"],
      "matchStrings": ["cargo install (?<depName>cargo-(?:deny|llvm-cov)) --version (?<currentValue>[0-9][^\\s]*)"],
      "datasourceTemplate": "crate"
    }
  ]
}
